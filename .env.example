# Database and Upload Storage Paths
# These paths should point to persistent storage outside the deployed code
# On Hostinger, create a folder at the same level as your project and set these:

# Path for database JSON files (e.g., /home/username/project-data/database)
DATA_PATH=/home/username/project-data/database

# Path for uploaded files (e.g., /home/username/project-data/uploads)
UPLOADS_PATH=/home/username/project-data/uploads
